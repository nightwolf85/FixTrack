<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox fx:controller="com.fixtrack.desktop.controller.ClientesController" padding="15" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <!-- TABLA DE CLIENTES -->
    <TableView fx:id="tableClientes" prefHeight="550.0" prefWidth="480.0">
        <columns>
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre"/>
            <TableColumn fx:id="colNif" prefWidth="100.0" text="NIF"/>
            <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Teléfono"/>
            <TableColumn fx:id="colDireccion" prefWidth="120.0" text="Dirección"/>
        </columns>
    </TableView>

    <!-- FORMULARIO DE ALTA -->
    <VBox prefWidth="250.0" spacing="10">
        <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Nuevo Cliente"/>
        <TextField fx:id="txtNombre" promptText="Nombre / Razón Social"/>
        <TextField fx:id="txtNif" promptText="NIF / CIF"/>
        <TextField fx:id="txtTelefono" promptText="Teléfono"/>
        <TextField fx:id="txtDireccion" promptText="Dirección"/>
        <Button onAction="#guardarCliente" prefWidth="250.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Guardar Cliente"/>
    </VBox>

</HBox>