<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conformidad_del_cliente_firma"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Lienzo táctil personalizado de firma -->
    <com.fixtrack.mobile.ui.FirmaCanvasView
        android:id="@+id/firmaCanvas"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@android:color/darker_gray"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnLimpiarFirma"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/borrar_firma"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnGuardarYCerrar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/boton_finalizar_parte"/>
    </LinearLayout>

</LinearLayout>