<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fixtrack.mobile">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="FixTrack"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <activity
            android:name="com.fixtrack.mobile.ui.OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.fixtrack.mobile.ui.LoginActivity"
            android:exported="false" />

        <activity
            android:name="com.fixtrack.mobile.MainActivity"
            android:exported="false" />

        <activity
            android:name="com.fixtrack.mobile.ui.CrearParteActivity"
            android:exported="false" />

        <activity
            android:name="com.fixtrack.mobile.ui.CerrarParteActivity"
            android:exported="false" />

    </application>

</manifest>